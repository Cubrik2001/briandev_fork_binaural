<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_replenishment" model="ir.ui.view">
        <field name="name">product.template.form.replenishment</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Reabastecimiento">
                    <field name="replenish_priority"/>
                    <field name="replenishment_target_qty"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_tree_replenishment" model="ir.ui.view">
        <field name="name">product.template.tree.replenishment</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='list_price']" position="after">
                <field name="replenish_priority" optional="show"/>
                <field name="replenishment_target_qty" optional="show"/>
                <field name="qty_available" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

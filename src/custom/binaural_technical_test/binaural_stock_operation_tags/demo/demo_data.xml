<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_tag_picking" model="stock.operation.tag">
        <field name="name">Picking rápido</field>
        <field name="color">2</field>
        <field name="description">Productos con alta rotación en picking</field>
        <field name="operation_type">picking</field>
    </record>

    <record id="demo_tag_storage" model="stock.operation.tag">
        <field name="name">Almacenamiento frío</field>
        <field name="color">4</field>
        <field name="description">Requiere cadena de frío</field>
        <field name="operation_type">storage</field>
    </record>

    <record id="demo_tag_dispatch" model="stock.operation.tag">
        <field name="name">Despacho express</field>
        <field name="color">9</field>
        <field name="description">Prioridad en despacho</field>
        <field name="operation_type">dispatch</field>
    </record>

    <record id="demo_product_tagged" model="product.template">
        <field name="name">Demo Producto Etiquetado</field>
        <field name="type">consu</field>
        <field name="operation_tag_ids" eval="[(4, ref('demo_tag_picking')), (4, ref('demo_tag_dispatch'))]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_operation_tag_assign_wizard_form" model="ir.ui.view">
        <field name="name">stock.operation.tag.assign.wizard.form</field>
        <field name="model">stock.operation.tag.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignar etiquetas operativas">
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>
                <group>
                    <field name="tag_ids_to_add" widget="many2many_tags"
                           options="{'color_field': 'color'}"/>
                    <field name="tag_ids_to_remove" widget="many2many_tags"
                           options="{'color_field': 'color'}"/>
                </group>
                <footer>
                    <button name="action_apply_tags" type="object"
                            string="Aplicar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
